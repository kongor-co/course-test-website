---
import { AdditionalCourseCurriculumPage } from '@/components/additional-course-page';
import { additionalCoursesByLocale, additionalCourseSlugs, type AdditionalCourseSlug } from '@/lib/course-catalog';
import { locales, type Locale } from '@/lib/site-content';
import SiteLayout from '../../../../layouts/SiteLayout.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) => additionalCourseSlugs.map((slug) => ({ params: { locale, slug } })));
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug as AdditionalCourseSlug;
const course = additionalCoursesByLocale[locale][slug];
const title = locale === 'de' ? `Curriculum: ${course.title}` : `${course.title} Curriculum`;
const description = locale === 'de' ? `Acht Phasen und zwei Lernrhythmen für ${course.title}.` : `Eight phases and two learning rhythms for ${course.title}.`;
---
<SiteLayout locale={locale} path={`courses/${slug}/curriculum`} title={title} description={description} useSocialImage={false}>
  <AdditionalCourseCurriculumPage locale={locale} course={course} client:load />
</SiteLayout>
