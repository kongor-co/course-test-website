---
import '../../app/globals.css';
import type { Locale } from '@/lib/site-content';
import type { PageName } from '@/components/static-site-page';

interface Props {
  locale: Locale;
  page?: PageName;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = page ? `/${page}/` : '/';
const canonical = new URL(`${basePath}/${locale}${pagePath}`, Astro.site);
const german = new URL(`${basePath}/de${pagePath}`, Astro.site);
const english = new URL(`${basePath}/en${pagePath}`, Astro.site);
const socialImage = new URL(`${basePath}/og.png`, Astro.site);
const completeTitle = title === 'The Best School' ? title : `${title} | The Best School`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={german} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="x-default" href={german} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Best School" />
    <meta property="og:title" content={completeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{completeTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
